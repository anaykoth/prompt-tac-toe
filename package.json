{
  "name": "prompt-tac-toe",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build --workspace=splinter-alley && next build",
    "start": "next start",
    "test": "node test-engine.mjs",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "build:darts": "npm run build --workspace=splinter-alley",
    "dev:darts": "npm run dev --workspace=splinter-alley",
    "test:darts": "npm run test --workspace=splinter-alley",
    "test:shared": "node games/shared/test/livecheck.mjs"
  },
  "dependencies": {
    "next": "^15.3.4",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "workspaces": [
    "games/darts"
  ]
}
